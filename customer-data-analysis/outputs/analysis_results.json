  "insights": [
    {
      "theme": "High-value customers",
      "title": "Value comes from how often customers buy, not from how much they put in one basket",
      "evidence": "Champions place 10.7 orders on average against 1.3 for Hibernating customers, but their average order is similar (\u00a3419 vs \u00a3356). Champions are 24% of customers and 67% of net revenue.",
      "interpretation": "A customer becomes valuable by returning, so order frequency is the lever that separates the best customers from the rest.",
      "recommendation": "Measure and manage the second and third order. Reward order frequency (for example a reorder incentive or account-manager contact for customers on their 3rd to 5th order) rather than pushing larger baskets."
    },
    {
      "theme": "Revenue concentration",
      "title": "A small group of customers carries the business",
      "evidence": "The top 10% of customers deliver 60% of net revenue and the top 1% (43 customers) deliver 30%. 1,166 customers (27%) produce 80% of revenue; the bottom half adds only 8%. Gini coefficient: 0.71.",
      "interpretation": "Losing even a few top accounts would be felt immediately in revenue, while the large base of small customers is cheap to lose but also adds little.",
      "recommendation": "Create a named-account programme for the top 1-5% (dedicated contact, early access to new products, service-level promises) and keep the long tail on low-cost, automated marketing."
    },
    {
      "theme": "At-risk customers",
      "title": "Customers who bought regularly and then went quiet are the best win-back target",
      "evidence": "384 customers (At Risk + Can't Lose Them) have spent \u00a3603k but have been inactive for 122-144 days on average; they used to place 3.5-5.9 orders. Can't Lose Them customers are worth \u00a32,326 each on average, and in the back-test 68% of that group still bought in the next 90 days.",
      "interpretation": "These customers have already proved they like the product. Their usual rhythm is a purchase every ~28 days (median), so a silence of four months or more is a clear warning sign, not normal behaviour.",
      "recommendation": "Run a personal win-back campaign for Can't Lose Them (call or personal email from an account manager, offer on their previously bought products) and an automated reminder sequence for At Risk. Trigger it when a customer passes about 90 days without an order."
    },
    {
      "theme": "Retention opportunity",
      "title": "Getting a first-time buyer to order again is the biggest growth lever",
      "evidence": "35% of customers bought only once and contribute 6.5% of net revenue; repeat customers (average 6.0 orders) contribute 93.5%. Only 47% of customers place a second order within 90 days of their first, and in any later month roughly 24% of a monthly cohort is active.",
      "interpretation": "Fewer than half of customers reorder within three months of their first purchase, and every monthly cohort loses most of its customers quickly, so the first 90 days decide whether a customer becomes a repeat buyer.",
      "recommendation": "Build a 90-day onboarding journey: a thank-you and product-care message after the first order, a reorder reminder at ~28 days, and a targeted offer at ~60 days for customers who have not yet reordered."
    },
    {
      "theme": "Segment differences",
      "title": "New customers and Potential Loyalists are a large pipeline that is still worth little today",
      "evidence": "New Customers + Potential Loyalists are 23% of customers (990) but only 5.9% of net revenue (average \u00a3551 for Potential Loyalists). Champions are worth \u00a35,412 on average, 10 times more.",
      "interpretation": "These customers bought recently but have not yet built a habit; if even a fraction move up to Loyal or Champions the revenue effect is large.",
      "recommendation": "Use 'next best product' recommendations and bundle offers to move them to a 3rd and 4th order. Track the share of this group that reaches Loyal Customers each quarter as a headline KPI."
    },
    {
      "theme": "Low-value inactive customers",
      "title": "Hibernating customers are the largest group but low priority",
      "evidence": "31% of customers (1,332) are Hibernating: average 209 days since last order, 1.3 orders and \u00a3440 spent. In the back-test only 34% bought in the next 90 days.",
      "interpretation": "Winning these customers back is possible but expensive relative to the value at stake.",
      "recommendation": "Include them only in low-cost, periodic campaigns (seasonal catalogue or email), and suppress them from paid channels. Use their purchase history to find which products brought them in and promote those."
    },
    {
      "theme": "Seasonality",
      "title": "Revenue is strongly seasonal: September to November is the peak season",
      "evidence": "September-November 2011 delivered \u00a33.00M (38% of all full-month net revenue). November 2011 was the best month at \u00a31.11M; the average of the other 2011 full months (Jan-Aug) was \u00a3548k. Order frequency is flat (about 1.3-1.6 orders per active customer per month), so the peak comes from more active customers (1,660 in the busiest month).",
      "interpretation": "The peak is driven by more customers buying in the same month (average order value and orders per customer do not rise in the same way), which is consistent with customers stocking up for the holiday season.",
      "recommendation": "Plan stock, staffing and marketing around the autumn peak, and start retention campaigns in October so that new seasonal customers are contacted again before the quieter early-year months."
    },
    {
      "theme": "Geography",
      "title": "The UK is the core market; a few overseas wholesalers are unusually valuable",
      "evidence": "The UK holds 90% of customers and 82% of net revenue (\u00a31,738 per customer). Highest revenue per customer outside the UK (countries with at least 3 customers): EIRE (\u00a382k per customer, 3 customers), Netherlands (\u00a331k per customer, 9 customers), Australia (\u00a315k per customer, 9 customers).",
      "interpretation": "Export revenue depends on a handful of accounts, which is both an opportunity (high value) and a risk (very small base).",
      "recommendation": "Treat the top overseas accounts as key accounts and test a small export wholesale offer in the countries where a few customers already spend heavily."
    },
    {
      "theme": "Purchasing pattern",
      "title": "Orders cluster mid-week and around midday",
      "evidence": "Thursday is the busiest day (4,003 orders) and 12:00 is the busiest hour. There are no orders at all recorded on Saturdays.",
      "interpretation": "Ordering during working hours on working days is consistent with a customer base that includes many business buyers.",
      "recommendation": "Send campaign emails early on Tuesday-Thursday mornings so they arrive before the midday ordering peak, and confirm whether the Saturday gap is a trading rule or a data-recording issue before drawing any conclusion from it."
    }
  ],
